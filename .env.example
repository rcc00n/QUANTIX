# Run make setup to generate local-only credentials. Never commit .env.
POSTGRES_DB=arbiq
POSTGRES_USER=arbiq
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://arbiq:REPLACE_WITH_GENERATED_PASSWORD@db:5432/arbiq
ADMIN_USERNAME=quantix
ADMIN_PASSWORD_HASH=
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:3100","http://127.0.0.1:3100"]
SESSION_TTL_SECONDS=28800
LOG_LEVEL=INFO
TRADING_MODE=paper
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# The bot token is injected only into the notification worker as a read-only
# protected file. Never paste it here. Empty setup placeholder means unconfigured.
TELEGRAM_TOKEN_FILE=/run/secrets/telegram_bot_token
NOTIFICATION_WORKER_ENABLED=false
QUANTIX_SECRET_UID=1000
QUANTIX_SECRET_GID=1000
NVIDIA_API_KEY=
NVIDIA_MODEL=
AI_ENABLED=false
AI_FREE_ALLOWANCE_AUTHORIZED=false
AI_FREE_ALLOWANCE_EXPIRES_AT=
AI_MAX_REQUESTS_PER_DAY=20
AI_MIN_REQUEST_INTERVAL_SECONDS=60
AI_CACHE_TTL_SECONDS=300
AI_REQUEST_TIMEOUT_SECONDS=10
AI_MAX_INPUT_BYTES=12000
AI_MAX_OUTPUT_TOKENS=400
# Optional provider is network-inert unless explicitly authorized and configured.
BACKEND_URL=http://backend:8000

FRONTEND_PORT=3100

# Local only. Reserved production configuration is for Stage 7.
PRODUCTION_DOMAIN=quantix.raccncode.com
PRODUCTION_APP_URL=https://quantix.raccncode.com
PUBLIC_APP_URL=http://localhost:3100
ADMIN_PREVIOUS_USERNAME=
COLLECTOR_URL=http://collector:8001
COLLECTOR_INTERNAL_TOKEN=
COLLECTOR__ENABLED=true
COLLECTOR__EXCHANGE_IDS=["kraken","ndax","coinbase","coinbaseexchange","cryptocom","bitstamp","gemini","binance","bybit","okx","bitfinex","kucoin","gate","mexc","bitget","htx","poloniex","bitso","luno","bitbank"]
COLLECTOR__EXCLUDE_EXCHANGES=[]
COLLECTOR__BASE_ASSETS=[]
COLLECTOR__QUOTE_ASSETS=["CAD","USD","USDC","USDT","EUR","BTC","JPY"]
COLLECTOR__MAX_MARKETS_PER_EXCHANGE=10
COLLECTOR__DEPTH=25
COLLECTOR__MAX_CONCURRENCY=6
COLLECTOR__MINIMUM_QUOTE_VOLUME=0
COLLECTOR__MINIMUM_BOOK_NOTIONAL=0
COLLECTOR__MAXIMUM_AGE_SECONDS=60
COLLECTOR__WEBSOCKET_EXCHANGES=["kraken","coinbaseexchange","okx"]
COLLECTOR__WEBSOCKET_FAST_MARKETS_PER_EXCHANGE=2
COLLECTOR__ACTIVE_ONLY=true
COLLECTOR__ALLOW_UNKNOWN_ACTIVE=true
COLLECTOR__SAMPLE_RETENTION_HOURS=24
COLLECTOR__QUALITY_RETENTION_DAYS=7
# Future Stage 6 only; no integrations/calls are enabled.
URGENT_ALERTS_ENABLED=false
ALERT_TIMEZONE=America/Edmonton
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
VOICE_PROVIDER=
VOICE_API_KEY=
VOICE_FROM_NUMBER=
VOICE_TO_NUMBER=
VOICE_CALLS_ENABLED=false

# Deterministic Stage 3 scanner; all routes remain research/paper only.
ARBITRAGE__ENABLED=true
ARBITRAGE__BUDGETS_CAD=["100","250","500","1000","2000","5000","10000"]
ARBITRAGE__DEFAULT_BUDGET_CAD=1000
ARBITRAGE__CONSERVATIVE_TAKER_RATE=0.006
ARBITRAGE__SLIPPAGE_BPS=10
ARBITRAGE__REBALANCING_BPS=10
ARBITRAGE__MAXIMUM_BOOK_AGE_SECONDS=30
ARBITRAGE__MAXIMUM_BOOK_SKEW_SECONDS=10
ARBITRAGE__MAX_CANDIDATES=500
ARBITRAGE__MAX_WRITES_PER_MINUTE=30
ARBITRAGE__PERSISTENCE_INTERVAL_SECONDS=120
ARBITRAGE__MAX_OPTIMIZER_EVALUATIONS=128

# Autonomous simulation only; never exchange orders.
PAPER__ENABLED=true
PAPER__BOOTSTRAP_PORTFOLIOS=true
PAPER__INTERVAL_SECONDS=2
PAPER__VALUATION_INTERVAL_SECONDS=60
PAPER__MAXIMUM_PENDING=100
PAPER__MAXIMUM_OBSERVATION_WAIT_SECONDS=90
PAPER__MAXIMUM_CANDIDATES_PER_TICK=10

# Set false after production takes ownership of the single Telegram consumer.
LOCAL_NOTIFICATION_WORKER_ENABLED=true
