[Unit]
Description=QUANTIX isolated capacity fail-safe
After=docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/quantix
ExecStart=/usr/bin/python3 /opt/quantix/scripts/production_guard.py
Restart=on-failure
RestartSec=30
UMask=0077
Nice=10
CPUWeight=10
MemoryMax=64M

[Install]
WantedBy=multi-user.target
